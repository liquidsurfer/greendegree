---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { brand } from '../config/brand.ts';
import imgSnapScan from '../assets/images/snapscan-qr.png';

const donateSchema = {
  '@context': 'https://schema.org',
  '@type': 'DonateAction',
  name: 'Donate to green°',
  description: 'Every donation funds stationery for children at three primary schools in the Western Cape, South Africa.',
  url: `${brand.siteUrl}/donate`,
  recipient: {
    '@type': 'NGO',
    name: 'green°',
    url: brand.siteUrl,
  },
};
---

<Layout title="donate — green°" description="Support green°. Every donation funds stationery for children at three primary schools in the Western Cape, South Africa. Secure card payments via Yoco.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(donateSchema)} />

<style>
/* ============================================================
   DONATE PAGE — pencil case funder, then the SnapScan rail
   The lime fills the calculator panel as generosity grows.
   The panel is a contained 100vh viewport rather than a page
   scroll lock, so the SnapScan block and the global footer
   stay reachable below it.
   ============================================================ */

.dn-viewport {
  position: relative;
  height: 100vh;
  overflow: hidden;
}

.dn-fill {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 0%;
  background: var(--color-lime);
  z-index: 0;
  transition: height 600ms cubic-bezier(0.16, 1, 0.3, 1);
  will-change: height;
}

.dn-stage {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80px var(--page-pad) 120px;
  text-align: center;
}

.dn-eyebrow {
  font-family: var(--font-ui);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-sage-deep);
  margin-bottom: 32px;
  display: flex;
  align-items: center;
  gap: 12px;
}
.dn-eyebrow::before,
.dn-eyebrow::after {
  content: "";
  display: inline-block;
  width: 24px;
  height: 1px;
  background: var(--color-sage-deep);
}

.dn-count-wrap {
  position: relative;
  display: flex;
  align-items: baseline;
  gap: 16px;
  justify-content: center;
  margin-bottom: 8px;
}
.dn-count {
  font-family: var(--font-display);
  font-weight: 300;
  font-size: clamp(6rem, 22vw, 18rem);
  line-height: 0.9;
  letter-spacing: -0.05em;
  color: var(--color-ink);
  font-variant-numeric: tabular-nums;
  transition: transform 160ms cubic-bezier(0.16, 1, 0.3, 1), color 600ms;
  will-change: transform;
  user-select: none;
}
.dn-count.is-bumping { transform: scale(1.04); }
.dn-count-label {
  font-family: var(--font-ui);
  font-size: clamp(0.85rem, 1.5vw, 1rem);
  font-weight: 400;
  letter-spacing: 0.06em;
  text-transform: lowercase;
  color: var(--color-ink-soft);
  align-self: flex-end;
  padding-bottom: 20px;
  white-space: nowrap;
}

.dn-cost {
  font-family: var(--font-display);
  font-weight: 300;
  font-size: clamp(1.5rem, 4vw, 3rem);
  letter-spacing: -0.02em;
  color: var(--color-ink);
  margin: 0 0 12px;
  transition: color 600ms;
}

.dn-human {
  font-family: var(--font-ui);
  font-size: clamp(0.8rem, 1.5vw, 0.9375rem);
  color: var(--color-ink-soft);
  margin: 0 0 48px;
  min-height: 1.5em;
  transition: color 600ms;
}

.dn-controls {
  display: flex;
  align-items: center;
  gap: 24px;
  margin-bottom: 56px;
}
.dn-btn {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  border: 1px solid var(--color-rule);
  background: transparent;
  font-family: var(--font-ui);
  font-size: 22px;
  font-weight: 300;
  color: var(--color-ink);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color 200ms, background 200ms, color 200ms;
  user-select: none;
  flex-shrink: 0;
}
.dn-btn:hover { border-color: var(--color-ink); background: var(--color-ink); color: var(--color-bg); }
.dn-btn:active { transform: scale(0.94); }

.dn-slider-wrap {
  position: relative;
  width: clamp(160px, 28vw, 320px);
}
.dn-slider {
  -webkit-appearance: none;
  appearance: none;
  width: 100%;
  height: 1px;
  background: var(--color-rule);
  outline: none;
  border-radius: 0;
  cursor: pointer;
}
.dn-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: var(--color-ink);
  cursor: pointer;
  transition: background 200ms, transform 200ms;
}
.dn-slider::-webkit-slider-thumb:hover { transform: scale(1.2); }
.dn-slider::-moz-range-thumb {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: var(--color-ink);
  border: none;
  cursor: pointer;
}
.dn-slider-ticks {
  display: flex;
  justify-content: space-between;
  margin-top: 8px;
}
.dn-slider-tick {
  font-family: var(--font-ui);
  font-size: 10px;
  color: var(--color-ink-faint);
  letter-spacing: 0.06em;
}

.dn-cta {
  font-family: var(--font-ui);
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 0.04em;
  text-transform: lowercase;
  padding: 18px 36px;
  background: var(--color-ink);
  color: var(--color-bg);
  border: 1px solid var(--color-ink);
  transition: background 200ms, color 200ms, border-color 200ms, opacity 200ms;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  cursor: pointer;
}
.dn-cta:hover:not(:disabled) { background: var(--color-sage-deep); border-color: var(--color-sage-deep); }
.dn-cta__amount { font-weight: 400; text-transform: none; }
.dn-cta__arrow { font-size: 18px; }

.dn-fill-label {
  position: absolute;
  bottom: 0%;
  left: 40px;
  z-index: 5;
  font-family: var(--font-ui);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--color-ink-faint);
  writing-mode: vertical-rl;
  transform: rotate(180deg);
  padding-bottom: 16px;
  user-select: none;
  opacity: 0;
  transition: opacity 600ms;
}
.dn-fill-label.is-shown { opacity: 1; }

@keyframes dn-label-bounce {
  0%   { transform: rotate(180deg) scale(1);    color: var(--color-ink-faint); }
  20%  { transform: rotate(180deg) scale(1.4);  color: var(--color-lime); }
  50%  { transform: rotate(180deg) scale(0.85); color: var(--color-sage-deep); }
  75%  { transform: rotate(180deg) scale(1.1);  color: var(--color-ink-faint); }
  100% { transform: rotate(180deg) scale(1);    color: var(--color-ink-faint); }
}
.dn-fill-label.is-bouncing {
  animation: dn-label-bounce 420ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.dn-note {
  position: absolute;
  bottom: 28px;
  right: 40px;
  font-family: var(--font-ui);
  font-size: 11px;
  color: var(--color-ink-faint);
  z-index: 10;
  letter-spacing: 0.04em;
}

.dn-success {
  position: absolute;
  inset: 0;
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16px;
  background: var(--color-lime);
  opacity: 0;
  pointer-events: none;
  transition: opacity 600ms;
}
.dn-success.is-shown { opacity: 1; pointer-events: auto; }
.dn-success__title {
  font-family: var(--font-display);
  font-weight: 300;
  font-size: clamp(4rem, 14vw, 10rem);
  line-height: 1;
  letter-spacing: -0.04em;
  color: var(--color-ink);
}
.dn-success__sub {
  font-family: var(--font-ui);
  font-size: clamp(0.85rem, 1.5vw, 1rem);
  color: var(--color-ink-soft);
  letter-spacing: 0.04em;
}

/* Shown when Yoco bounces the donor back via failureUrl. Sand rather
   than lime: the card was declined, but the donor did nothing wrong. */
.dn-fail {
  position: absolute;
  inset: 0;
  z-index: 21;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16px;
  padding: 40px var(--page-pad);
  text-align: center;
  background: var(--color-bg-tint);
  opacity: 0;
  pointer-events: none;
  transition: opacity 400ms;
}
.dn-fail.is-shown { opacity: 1; pointer-events: auto; }
.dn-fail:focus { outline: none; }
.dn-fail__title {
  font-family: var(--font-display);
  font-weight: 300;
  font-size: clamp(3rem, 10vw, 7rem);
  line-height: 1;
  letter-spacing: -0.04em;
  color: var(--color-ink);
}
.dn-fail__sub {
  font-family: var(--font-ui);
  font-size: clamp(0.85rem, 1.5vw, 1rem);
  line-height: 1.6;
  color: var(--color-ink-soft);
  letter-spacing: 0.04em;
  max-width: 46ch;
}
.dn-fail__actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12px;
  margin-top: 16px;
}
.dn-fail__btn {
  font-family: var(--font-ui);
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 0.04em;
  text-transform: lowercase;
  padding: 16px 32px;
  background: transparent;
  color: var(--color-ink);
  border: 1px solid var(--color-ink);
  transition: background 200ms, color 200ms, border-color 200ms;
  cursor: pointer;
}
.dn-fail__btn:hover { background: var(--color-sand); }
.dn-fail__btn--primary {
  background: var(--color-ink);
  color: var(--color-bg);
}
.dn-fail__btn--primary:hover {
  background: var(--color-sage-deep);
  border-color: var(--color-sage-deep);
}

@media (max-width: 640px) {
  .dn-fail { padding: 40px var(--page-pad-mobile); }
  .dn-fail__actions { flex-direction: column; align-self: stretch; }
  .dn-fail__btn { width: 100%; }
}

@media (max-width: 640px) {
  .dn-stage { padding: 80px var(--page-pad-mobile) 100px; }
  .dn-controls { gap: 16px; }
  .dn-slider-wrap { width: 140px; }
  .dn-note { display: none; }
  .dn-fill-label { left: 12px; }
}

.dn-cue {
  position: absolute;
  bottom: 28px;
  right: 40px;
  z-index: 10;
  color: var(--color-ink-faint);
  pointer-events: none;
  opacity: 0;
  animation: dn-cue-fadein 600ms ease 2.5s forwards;
  display: flex;
  flex-direction: row-reverse;
  align-items: center;
  gap: 10px;
}
.dn-cue::before {
  content: "fill";
  font-family: var(--font-ui);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  opacity: 0.6;
}
.dn-cue svg {
  animation: hp-cue 2s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  transform: rotate(0deg);
}
@keyframes dn-cue-fadein {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@media (max-width: 640px) {
  .dn-cue { display: none; }
}
@media (prefers-reduced-motion: reduce) {
  .dn-cue { animation: none; opacity: 1; }
  .dn-cue svg { animation: none; }
}

/* ============================================================
   SNAPSCAN — second rail, carried over from the original site
   ============================================================ */
.dn-snap {
  background: var(--color-bg);
  padding: 104px var(--page-pad);
  border-top: 1px solid var(--color-rule);
}
.dn-snap__inner {
  max-width: var(--page-max);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 64px;
  align-items: center;
}
.dn-snap__eyebrow { display: inline-block; margin-bottom: 24px; }
.dn-snap__title {
  font-family: var(--font-display);
  font-weight: 300;
  font-size: clamp(1.75rem, 3.4vw, 2.75rem);
  line-height: 1.1;
  letter-spacing: -0.025em;
  color: var(--color-ink);
  margin: 0 0 20px;
}
.dn-snap__lead,
.dn-snap__closing {
  font-family: var(--font-ui);
  font-size: 15px;
  line-height: 1.7;
  color: var(--color-ink-soft);
  margin: 0;
  max-width: 44ch;
}
.dn-snap__closing { margin-top: 12px; font-style: italic; color: var(--color-sage-deep); }
.dn-snap__code {
  background: #fff;
  padding: 18px;
  border: 1px solid var(--color-rule);
  line-height: 0;
}
.dn-snap__code img { width: 240px; height: auto; }
@media (max-width: 820px) {
  .dn-snap { padding: 72px var(--page-pad-mobile); }
  .dn-snap__inner { grid-template-columns: 1fr; gap: 40px; justify-items: start; }
  .dn-snap__code img { width: 200px; }
}
</style>

<div class="dn-viewport">
<div class="dn-fill" id="dn-fill"></div>

<main class="dn-stage">
  <div class="dn-eyebrow">fill a pencil case</div>

  <div class="dn-count-wrap">
    <div class="dn-count" id="dn-count">5</div>
    <div class="dn-count-label">pencil cases</div>
  </div>

  <p class="dn-cost" id="dn-cost">R750</p>
  <p class="dn-human" id="dn-human">equips 5 children with stationery for the school year</p>

  <div class="dn-controls">
    <button class="dn-btn" id="dn-dec" aria-label="decrease">&minus;</button>
    <div class="dn-slider-wrap">
      <input class="dn-slider" id="dn-slider" type="range" min="1" max="50" value="5" aria-label="number of pencil cases">
      <div class="dn-slider-ticks">
        <span class="dn-slider-tick">1</span>
        <span class="dn-slider-tick">10</span>
        <span class="dn-slider-tick">25</span>
        <span class="dn-slider-tick">50</span>
      </div>
    </div>
    <button class="dn-btn" id="dn-inc" aria-label="increase">+</button>
  </div>

  <button class="dn-cta" id="dn-cta" type="button">
    <span>donate</span>
    <span class="dn-cta__amount" id="dn-cta-amount">R750</span>
    <span class="dn-cta__arrow">&rarr;</span>
  </button>
</main>

<div class="dn-fill-label" id="dn-fill-label">growing</div>
<div class="dn-note">R150 per pencil case &middot; 100% goes to the children</div>

<div class="dn-cue" aria-hidden="true">
  <svg viewBox="0 0 24 24" width="22" height="22" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 20V5m0 0l-6 6m6-6l6 6"/>
  </svg>
</div>

<div class="dn-success" id="dn-success" aria-live="polite" aria-hidden="true">
  <p class="dn-success__title">thank you</p>
  <p class="dn-success__sub" id="dn-success-sub">your pencil cases are on their way</p>
</div>

<div class="dn-fail" id="dn-fail" role="alert" aria-hidden="true" tabindex="-1">
  <p class="dn-fail__title">no luck</p>
  <p class="dn-fail__sub">That payment didn&rsquo;t go through, and nothing was taken from your account. Card payments are giving us trouble at the moment &mdash; SnapScan is working perfectly if you&rsquo;d like to try that instead.</p>
  <div class="dn-fail__actions">
    <button type="button" class="dn-fail__btn dn-fail__btn--primary" id="dn-fail-snap">donate via snapscan</button>
    <button type="button" class="dn-fail__btn" id="dn-fail-retry">try card again</button>
  </div>
</div>
</div>

<!-- SNAPSCAN — second rail, and the one the original site used -->
<section class="dn-snap" id="dn-snap" aria-labelledby="dn-snap-title">
  <div class="dn-snap__inner">
    <div class="dn-snap__copy">
      <span class="gn-eyebrow dn-snap__eyebrow">another way to give</span>
      <h2 class="dn-snap__title" id="dn-snap-title">or donate via snapscan<span class="gn-deg">.</span></h2>
      <p class="dn-snap__lead">Please use the code below to donate via SnapScan.</p>
      <p class="dn-snap__closing">Your support is SO appreciated.</p>
    </div>
    <div class="dn-snap__code">
      <Image src={imgSnapScan} alt="SnapScan QR code for donating to green°" width={320} format="webp" />
    </div>
  </div>
</section>

<script is:inline>
(function () {
  var RATE = 150;
  var MAX  = 50;

  var countEl     = document.getElementById('dn-count');
  var costEl      = document.getElementById('dn-cost');
  var humanEl     = document.getElementById('dn-human');
  var fillEl      = document.getElementById('dn-fill');
  var slider      = document.getElementById('dn-slider');
  var decBtn      = document.getElementById('dn-dec');
  var incBtn      = document.getElementById('dn-inc');
  var ctaBtn      = document.getElementById('dn-cta');
  var ctaAmountEl = document.getElementById('dn-cta-amount');
  var fillLabel   = document.getElementById('dn-fill-label');
  var successEl   = document.getElementById('dn-success');
  var successSub  = document.getElementById('dn-success-sub');

  var count = 5;

  function fmt(n) { return 'R' + n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' '); }

  function humanLine(n) {
    if (n === 1)  return 'equips 1 child with stationery for the school year';
    if (n <= 9)   return 'equips ' + n + ' children with stationery for the school year';
    if (n <= 29)  return 'equips ' + n + ' children — nearly a full classroom';
    if (n === 30) return 'fills an entire classroom — every child, equipped.';
    if (n < 50)   return 'equips ' + n + ' children. you\'re changing lives.';
    return 'fifty pencil cases. a whole classroom and then some.';
  }

  function bounceFillLabel() {
    fillLabel.classList.remove('is-bouncing');
    void fillLabel.offsetWidth;
    fillLabel.classList.add('is-bouncing');
  }

  function bump() {
    countEl.classList.add('is-bumping');
    setTimeout(function () { countEl.classList.remove('is-bumping'); }, 200);
  }

  function update(newCount, fromSlider) {
    count = Math.max(1, Math.min(MAX, newCount));

    countEl.textContent = count;
    var cost = count * RATE;
    costEl.textContent = fmt(cost);
    humanEl.textContent = humanLine(count);
    ctaAmountEl.textContent = fmt(cost);

    var fillPct = Math.round((count / MAX) * 100);
    fillEl.style.height = fillPct + '%';
    fillLabel.style.bottom = fillPct + '%';

    if (!fromSlider) slider.value = Math.min(count, MAX);

    if (count > 1) { fillLabel.classList.add('is-shown'); bounceFillLabel(); }
    else           { fillLabel.classList.remove('is-shown'); }

    bump();
  }

  function setLoading(on) {
    ctaBtn.disabled = on;
    ctaBtn.style.opacity = on ? '0.5' : '';
  }

  ctaBtn.addEventListener('click', function () {
    var amountInCents = count * RATE * 100;
    setLoading(true);
    fetch('/api/charge', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ amountInCents: amountInCents }),
    })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.redirectUrl) {
          /* replace(), not href: pushing a history entry here leaves /donate
             sandwiched inside Yoco's own redirect chain, so pressing back
             bounces between the two instead of leaving the site. */
          window.location.replace(data.redirectUrl);
        } else {
          setLoading(false);
          alert('Could not start checkout. Please try again.');
        }
      })
      .catch(function () {
        setLoading(false);
        alert('Something went wrong. Please try again.');
      });
  });

  update(count);

  // Show success state if Yoco redirected back after payment
  var params = new URLSearchParams(window.location.search);
  if (params.get('donated') === 'true') {
    fillEl.style.transition = 'none';
    fillEl.style.height = '100%';
    successSub.textContent = 'your donation is on its way. thank you.';
    successEl.setAttribute('aria-hidden', 'false');
    successEl.classList.add('is-shown');
    history.replaceState(null, '', '/donate');
  }

  // Yoco sends declined donors back to failureUrl. Without this they land on
  // a pristine donate page with no idea the payment didn't take.
  var failEl = document.getElementById('dn-fail');

  function hideFail() {
    failEl.classList.remove('is-shown');
    failEl.setAttribute('aria-hidden', 'true');
  }

  if (params.get('failed') === 'true') {
    failEl.setAttribute('aria-hidden', 'false');
    failEl.classList.add('is-shown');
    failEl.focus();
    history.replaceState(null, '', window.location.pathname);
  }

  document.getElementById('dn-fail-retry').addEventListener('click', hideFail);

  document.getElementById('dn-fail-snap').addEventListener('click', function () {
    hideFail();
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.getElementById('dn-snap').scrollIntoView({
      behavior: reduce ? 'auto' : 'smooth',
      block: 'start',
    });
  });

  decBtn.addEventListener('click', function () { update(count - 1); });
  incBtn.addEventListener('click', function () { update(count + 1); });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'ArrowUp'   || e.key === 'ArrowRight') { e.preventDefault(); update(count + 1); }
    if (e.key === 'ArrowDown' || e.key === 'ArrowLeft')  { e.preventDefault(); update(count - 1); }
  });

  slider.addEventListener('input', function () {
    update(parseInt(slider.value, 10), true);
  });

  var scrollAccum = 0;
  var SCROLL_THRESHOLD = 60;
  document.addEventListener('wheel', function (e) {
    e.preventDefault();
    scrollAccum += e.deltaY;
    if (Math.abs(scrollAccum) >= SCROLL_THRESHOLD) {
      update(count + (scrollAccum > 0 ? 1 : -1));
      scrollAccum = 0;
    }
  }, { passive: false });

  function holdRepeat(btn, dir) {
    var timer, interval;
    btn.addEventListener('mousedown', function () {
      update(count + dir);
      timer = setTimeout(function () {
        interval = setInterval(function () { update(count + dir); }, 80);
      }, 500);
    });
    function stop() { clearTimeout(timer); clearInterval(interval); }
    btn.addEventListener('mouseup', stop);
    btn.addEventListener('mouseleave', stop);
    btn.addEventListener('touchstart', function (e) {
      e.preventDefault();
      update(count + dir);
      timer = setTimeout(function () {
        interval = setInterval(function () { update(count + dir); }, 80);
      }, 500);
    }, { passive: false });
    btn.addEventListener('touchend', stop);
  }
  holdRepeat(incBtn, 1);
  holdRepeat(decBtn, -1);
})();
</script>

</Layout>
